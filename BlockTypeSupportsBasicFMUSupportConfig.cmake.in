@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PySysLinkBase REQUIRED)

# Specify the include directories and libraries
set_and_check(BLOCK_TYPE_SUPPORTS_BASIC_FMU_SUPPORT_INCLUDE_DIRS "@PACKAGE_INCLUDE_DIRS@")
set_and_check(BLOCK_TYPE_SUPPORTS_BASIC_FMU_SUPPORT_LIBRARIES "@PACKAGE_LIBRARIES@")

# Set include directories for BlockTypeSupportsBasicFMUSupport
set(BlockTypeSupportsBasicFMUSupport_INCLUDE_DIRS "${CMAKE_INSTALL_PREFIX}/include")
set(BlockTypeSupportsBasicFMUSupport_LIBRARIES "@PACKAGE_LIBRARIES@")

include("${CMAKE_CURRENT_LIST_DIR}/BlockTypeSupportsBasicFMUSupportTargets.cmake")

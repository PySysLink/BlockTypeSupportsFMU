pluginName: basic_blocks_FMU
pluginType: coreBlockLibrary
blockType: BasicFMU
version: @PROJECT_VERSION@
dependsOn:
  - name: BlockTypesBasicFMU
    version: @PROJECT_VERSION@
blockLibraries:
  - name: BasicBlocksFMU
    blockTypes:
      - name: BasicFMU
        configurationValues:
          - name: FMUPath
            defaultValue: ""
            type: string
          - name: FMUInputVariables
            type: string[]
            defaultValue: []
          - name: FMUOutputVariables
            type: string[]
            defaultValue: []
        inputPortNumber: length(FMUInputVariables)
        outputPortNumber: length(FMUOutputVariables)
        inputPortTypes:
          all:
            port_category: FullySupportedSignalValue
            signal_value_type: double
        outputPortTypes:
          all: 
            port_category: FullySupportedSignalValue
            signal_value_type: double
    
      